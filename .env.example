# Copy this file to .env and replace both password placeholders locally.
# .env is ignored by Git. Do not commit real credentials.
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_another_long_random_password
JWT_SECRET=replace_with_at_least_32_random_characters
TZ=Asia/Shanghai
